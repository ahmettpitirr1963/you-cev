{
  "manifest_version": 3,
  "name": "You-Cev — YouTube Türkçe Seslendirme",
  "version": "0.2.0",
  "description": "YouTube videolarını eş zamanlı Türkçe seslendirme ve altyazıyla izleyin (yerel You-Cev sunucusu gerekir).",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["sync-player.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "You-Cev" }
}
